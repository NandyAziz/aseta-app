{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/cohere/north-mini-code:free",
  "instructions": [
    "AGENTS.md",
    "docs/architecture.md",
    ".agents/rules/aseta-coding-standards.md"
  ],
  "permissions": {
    "read": "allow",
    "write": "allow",
    "exec": "allow"
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest", "--browser", "chromium"]
      }
    }
  }
}